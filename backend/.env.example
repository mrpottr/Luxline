APP_NAME=Luxline API
APP_ENV=development
APP_VERSION=1.0.0
# MongoDB (Docker): mongodb://db:27017/luxline
# MongoDB (Localhost): mongodb://localhost:27017/luxline
DATABASE_URL=mongodb://localhost:27017/luxline
JWT_SECRET=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=120
CORS_ORIGINS=*
DEFAULT_CURRENCY=USD
STRIPE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_FROM_NAME=
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Broker Panel (disabled by default)
BROKER_PANEL_ENABLED=false
BROKER_LISTING_PRICE_FLOORS_JSON={}
BROKER_LISTING_MINIMUM_MEDIA_COUNT=5
BROKER_LISTING_BULK_MAX_ROWS=500
BROKER_BULK_REQUESTS_PER_MINUTE=10
BROKER_MEDIA_UPLOADS_PER_MINUTE=20
BROKER_MEDIA_STORAGE=mock_mongo
BROKER_VIRUS_SCANNER=mock
# The mock scanner rejects the EICAR test marker. Replace it before public launch.
PROMETHEUS_INTERNAL_URL=http://localhost:9090
GRAFANA_INTERNAL_URL=http://localhost:3000
