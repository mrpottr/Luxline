APP_NAME=Luxline API
APP_ENV=development
APP_VERSION=1.0.0
DATABASE_URL=sqlite:///./luxline.db
JWT_SECRET=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=120
CORS_ORIGINS=*
DEFAULT_CURRENCY=USD
STRIPE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_FROM_NAME=
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
